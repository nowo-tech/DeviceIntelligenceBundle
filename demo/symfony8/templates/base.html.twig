<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'demo.title'|trans }}{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        {{ vite_entry_link_tags('app') }}
        {% block stylesheets %}{% endblock %}
            {{ vite_entry_link_tags('app') }}
    </head>
    <body class="bg-light">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" href="{{ path('homepage', { _locale: app.request.locale }) }}">{{ 'demo.brand'|trans }}</a>
                <div class="navbar-nav ms-auto">
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-white" href="#" id="localeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            {{ 'demo.language'|trans }} ({{ app.request.locale|upper }})
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="localeDropdown">
                            <li><a class="dropdown-item {{ app.request.locale == 'en' ? 'active' : '' }}" href="{{ path('homepage', { _locale: 'en' }) }}">English</a></li>
                            <li><a class="dropdown-item {{ app.request.locale == 'es' ? 'active' : '' }}" href="{{ path('homepage', { _locale: 'es' }) }}">Español</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>
        {% block body %}{% endblock %}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {{ vite_entry_script_tags('app') }}
        {% block javascripts %}{% endblock %}
            {{ vite_entry_script_tags('app') }}
    </body>
</html>
