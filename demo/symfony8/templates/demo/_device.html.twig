{% if device %}
    <div class="nowo-ui-kpis">
        <div class="nowo-ui-kpi">
            <div class="nowo-ui-kpi__label">{{ 'demo.panel.device_id'|trans }}</div>
            <div class="nowo-ui-kpi__value"><code>{{ device.device.id.value }}</code></div>
        </div>
        <div class="nowo-ui-kpi">
            <div class="nowo-ui-kpi__label">{{ 'demo.panel.risk'|trans }}</div>
            <div class="nowo-ui-kpi__value">{{ device.risk.score.value }}</div>
            <div class="nowo-ui-kpi__hint">{{ device.risk.level.value }}</div>
        </div>
        <div class="nowo-ui-kpi">
            <div class="nowo-ui-kpi__label">{{ 'demo.panel.confidence'|trans }}</div>
            <div class="nowo-ui-kpi__value">{{ device.match.confidence|number_format(2) }}</div>
        </div>
        <div class="nowo-ui-kpi">
            <div class="nowo-ui-kpi__label">{{ 'demo.panel.new'|trans }}</div>
            <div class="nowo-ui-kpi__value">{{ device.new ? 'demo.yes'|trans : 'demo.no'|trans }}</div>
        </div>
        <div class="nowo-ui-kpi">
            <div class="nowo-ui-kpi__label">{{ 'demo.panel.trusted'|trans }}</div>
            <div class="nowo-ui-kpi__value">{{ device.trusted ? 'demo.yes'|trans : 'demo.no'|trans }}</div>
        </div>
    </div>
    {% if device.risk.reasons is not empty %}
        <p class="nowo-ui-muted">
            {{ 'demo.panel.reasons'|trans }}:
            {% for reason in device.risk.reasons %}
                {{ reason.label }}{% if not loop.last %}, {% endif %}
            {% endfor %}
        </p>
    {% endif %}
{% else %}
    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">{{ 'demo.panel.missing'|trans }}</div>
{% endif %}
