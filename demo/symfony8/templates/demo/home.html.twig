{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.title'|trans }} – {{ ('demo.case.' ~ case ~ '.nav')|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.heading'|trans,
        intro: 'demo.lead'|trans,
    }) }}
{% endblock %}

{% block body %}
    <p class="nowo-ui-muted">{{ 'demo.body'|trans }}</p>

    <nav class="nowo-ui-tabs nowo-ui-tabs--pill" aria-label="{{ 'demo.heading'|trans }}">
        {% for item in cases %}
            <a class="nowo-ui-tabs__item{{ case == item.id ? ' nowo-ui-tabs__item--active' : '' }}" href="{{ item.url }}"{% if case == item.id %} aria-current="page"{% endif %}>
                {{ ('demo.case.' ~ item.id ~ '.nav')|trans }}
            </a>
        {% endfor %}
    </nav>

    {{ include('demo/_device.html.twig') }}

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">{{ ('demo.case.' ~ case ~ '.title')|trans }}</h2>
            <p>{{ ('demo.case.' ~ case ~ '.body')|trans }}</p>
            {{ include('demo/cases/_' ~ case ~ '.html.twig') }}
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <h2 class="nowo-ui-card__title">{{ 'demo.collect_heading'|trans }}</h2>
            <pre id="collect-result" class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ 'demo.waiting'|trans }}</pre>
        </div>
    </section>
    <p class="nowo-ui-muted">{{ 'demo.docs_hint'|trans }}</p>
{% endblock %}
