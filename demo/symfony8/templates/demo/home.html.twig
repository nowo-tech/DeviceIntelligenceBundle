{% extends 'base.html.twig' %}

{% block title %}{{ 'demo.title'|trans }} – {{ ('demo.case.' ~ case ~ '.nav')|trans }}{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'demo.heading'|trans,
        intro: 'demo.lead'|trans,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.panel.heading'|trans, intro: 'demo.body'|trans, kind: 'detail', state: device ? null : 'empty', state_message: 'demo.panel.missing'|trans, device: device} %}
        {% block section_body %}
            {{ include('demo/_device.html.twig') }}
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: ('demo.case.' ~ case ~ '.title')|trans, intro: ('demo.case.' ~ case ~ '.body')|trans, kind: 'content', case: case, state: (case == 'alerts' and not suspicious) ? 'empty' : null, state_message: 'demo.case.alerts.empty'|trans} %}
        {% block section_body %}
            {{ include('demo/cases/_' ~ case ~ '.html.twig') }}
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'demo.collect_heading'|trans, kind: 'detail'} %}
        {% block section_body %}
            <pre id="collect-result" class="nowo-ui-code-block nowo-ui-code-block--wrap">{{ 'demo.waiting'|trans }}</pre>
        {% endblock %}
        {% block section_footer %}<span class="nowo-ui-muted">{{ 'demo.docs_hint'|trans }}</span>{% endblock %}
    {% endembed %}
{% endblock %}
