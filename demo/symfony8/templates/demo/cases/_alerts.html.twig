{% if suspicious %}
    <dl class="nowo-ui-detail-list">
        <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ 'demo.panel.device_id'|trans }}</dt>
        <dd class="nowo-ui-detail-list__value"><code>{{ suspicious.device_id }}</code></dd></div>
        <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ 'demo.panel.risk'|trans }}</dt>
        <dd class="nowo-ui-detail-list__value">{{ suspicious.score }} ({{ suspicious.level }})</dd></div>
        <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ 'demo.panel.reasons'|trans }}</dt>
        <dd class="nowo-ui-detail-list__value">{{ suspicious.reasons|join(', ') }}</dd></div>
        <div class="nowo-ui-detail-list__item"><dt class="nowo-ui-detail-list__term">{{ 'demo.case.alerts.at'|trans }}</dt>
        <dd class="nowo-ui-detail-list__value">{{ suspicious.at }}</dd></div>
    </dl>
{% else %}
    <p class="nowo-ui-muted">{{ 'demo.case.alerts.empty'|trans }}</p>
{% endif %}
