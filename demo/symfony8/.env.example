###> symfony/framework-bundle ###
# APP_ENV: Symfony environment (dev/test/prod). Demos run in `dev`.
APP_ENV=dev
# APP_SECRET: secret used to sign cookies, CSRF tokens and URIs. Use a local-only random value.
APP_SECRET=change_this_secret_key_to_a_random_value
# APP_DEBUG: enable detailed errors and the debug toolbar (`1` in dev, `0` in prod).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker
###< symfony/framework-bundle ###

# PORT: host port published by the demo web server (FrankenPHP/Caddy).
PORT=8038

###> symfony/routing ###
# DEFAULT_URI: base URL used by the router to build absolute URLs outside HTTP requests (CLI, emails). Keep it in sync with PORT.
DEFAULT_URI=http://localhost:8038
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL: Doctrine connection URL for the demo database service in docker-compose.
DATABASE_URL="mysql://app:app@db:3306/app?serverVersion=8.0.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
