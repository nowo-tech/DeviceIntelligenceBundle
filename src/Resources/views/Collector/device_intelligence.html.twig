{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        <span class="sf-toolbar-value">DI</span>
        {% if collector.hasContext %}
            <span class="sf-toolbar-label">{{ collector.risk }}</span>
        {% endif %}
    {% endset %}
    {% set text %}
        {% if collector.hasContext %}
            <div class="sf-toolbar-info-piece">
                <b>{{ 'profiler.device'|trans({}, 'NowoDeviceIntelligenceBundle') }}</b>
                <span>{{ collector.deviceId }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>{{ 'profiler.new'|trans({}, 'NowoDeviceIntelligenceBundle') }}</b>
                <span>{{ collector.new ? 'profiler.yes'|trans({}, 'NowoDeviceIntelligenceBundle') : 'profiler.no'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>{{ 'profiler.risk'|trans({}, 'NowoDeviceIntelligenceBundle') }}</b>
                <span>{{ collector.risk }} ({{ collector.riskLevel }})</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>{{ 'profiler.confidence'|trans({}, 'NowoDeviceIntelligenceBundle') }}</b>
                <span>{{ collector.confidence|number_format(2) }}</span>
            </div>
        {% else %}
            <div class="sf-toolbar-info-piece">
                <b>{{ 'profiler.device'|trans({}, 'NowoDeviceIntelligenceBundle') }}</b>
                <span>{{ 'profiler.no_observation'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
            </div>
        {% endif %}
    {% endset %}
    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: true }) }}
{% endblock %}

{% block menu %}
    <span class="label">
        <span class="icon">DI</span>
        <strong>{{ 'profiler.menu'|trans({}, 'NowoDeviceIntelligenceBundle') }}</strong>
    </span>
{% endblock %}

{% block panel %}
    <h2>{{ 'profiler.title'|trans({}, 'NowoDeviceIntelligenceBundle') }}</h2>
    {% if not collector.hasContext %}
        <div class="empty">
            <p>{{ 'profiler.empty'|trans({}, 'NowoDeviceIntelligenceBundle') }}</p>
            <p>{{ 'profiler.empty_hint'|trans({}, 'NowoDeviceIntelligenceBundle') }}</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.deviceId }}</span>
                <span class="label">{{ 'profiler.device_id'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.new ? 'profiler.yes'|trans({}, 'NowoDeviceIntelligenceBundle') : 'profiler.no'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
                <span class="label">{{ 'profiler.new'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.confidence|number_format(3) }}</span>
                <span class="label">{{ 'profiler.confidence'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.similarity|number_format(3) }}</span>
                <span class="label">{{ 'profiler.similarity'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.stability|number_format(3) }}</span>
                <span class="label">{{ 'profiler.stability'|trans({}, 'NowoDeviceIntelligenceBundle') }}</span>
            </div>
            <div class="metric">
                <span class="value">{{ collector.risk }}</span>
                <span class="label">{{ 'profiler.risk'|trans({}, 'NowoDeviceIntelligenceBundle') }} ({{ collector.riskLevel }})</span>
            </div>
        </div>

        <h3>{{ 'profiler.reasons'|trans({}, 'NowoDeviceIntelligenceBundle') }}</h3>
        {% if collector.reasons is empty %}
            <p>{{ 'profiler.no_reasons'|trans({}, 'NowoDeviceIntelligenceBundle') }}</p>
        {% else %}
            <ul>
                {% for reason in collector.reasons %}
                    <li>{{ reason }}</li>
                {% endfor %}
            </ul>
        {% endif %}

        <h3>{{ 'profiler.signals'|trans({}, 'NowoDeviceIntelligenceBundle') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ 'profiler.name'|trans({}, 'NowoDeviceIntelligenceBundle') }}</th>
                    <th>{{ 'profiler.summary'|trans({}, 'NowoDeviceIntelligenceBundle') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for name, summary in collector.signals %}
                    <tr>
                        <td>{{ name }}</td>
                        <td>{{ summary }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <h3>{{ 'profiler.timings'|trans({}, 'NowoDeviceIntelligenceBundle') }}</h3>
        <table>
            <thead>
                <tr>
                    <th>{{ 'profiler.phase'|trans({}, 'NowoDeviceIntelligenceBundle') }}</th>
                    <th>{{ 'profiler.ms'|trans({}, 'NowoDeviceIntelligenceBundle') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for phase, ms in collector.timings %}
                    <tr>
                        <td>{{ phase }}</td>
                        <td>{{ ms|number_format(2) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <p>{{ 'profiler.observation'|trans({}, 'NowoDeviceIntelligenceBundle') }} {{ collector.observationId }}{% if collector.degraded %} — {{ 'profiler.degraded'|trans({}, 'NowoDeviceIntelligenceBundle') }}{% endif %}{% if collector.trusted %} — {{ 'profiler.trusted'|trans({}, 'NowoDeviceIntelligenceBundle') }}{% endif %}</p>
    {% endif %}
{% endblock %}
