{
    "name": "device-intelligence-bundle-assets",
    "version": "1.0.1",
    "description": "Browser assets for nowo-tech/device-intelligence-bundle (private, not published to npm).",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "build": "vite build",
        "dev": "vite build --watch",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint src/Resources/assets/src src/Resources/assets/tests",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.5",
        "@vitest/coverage-v8": "^3.2.6",
        "eslint": "^10.8.1",
        "jsdom": "^25.0.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.19.0",
        "vite": "^8.2.2",
        "vitest": "^3.0.4"
    },
    "pnpm": {
        "onlyBuiltDependencies": ["esbuild"]
    }
}
